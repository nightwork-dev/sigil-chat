{
  "name": "sigil-chat-agent",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "eve build",
    "dev": "portless run --name sigil-chat-agent eve dev --no-ui --host 127.0.0.1",
    "healthcheck": "node scripts/healthcheck.mjs",
    "start": "eve start --host 127.0.0.1",
    "test": "vitest run && pnpm test:cold-boot",
    "test:cold-boot": "node scripts/cold-boot-smoke.mjs",
    "test:fabric-image-smoke": "node scripts/fabric-image-smoke.mjs",
    "test:fabric-topology": "vitest run agent/lib/fabric-topology.live.test.ts",
    "test:hosted-provider-smoke": "node scripts/hosted-provider-eve-smoke.mjs",
    "test:openai-compatible-smoke": "node scripts/openai-compatible-eve-smoke.mjs",
    "test:participant-channel": "node scripts/participant-channel-openai-compatible-eve-smoke.mjs",
    "test:sandbox": "node scripts/sandbox-smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.23",
    "@ai-sdk/openai-compatible": "3.0.16",
    "@gonk/auth": "catalog:",
    "@gonk/context": "catalog:",
    "@gonk/eve-host": "catalog:",
    "@gonk/image-gen": "catalog:",
    "@gonk/knowledge": "catalog:",
    "@gonk/memory": "catalog:",
    "@gonk/persona": "catalog:",
    "@gonk/retrieval": "catalog:",
    "@gonk/scope": "catalog:",
    "@gonk/skills": "catalog:",
    "@gonk/store": "catalog:",
    "@gonk/tool-registry": "catalog:",
    "@openrouter/ai-sdk-provider": "3.0.0",
    "@workspace/agent-contracts": "workspace:*",
    "@workspace/agent-tools": "workspace:*",
    "@workspace/artifact-store": "workspace:*",
    "@workspace/blackboard-store": "workspace:*",
    "@workspace/graph-store": "workspace:*",
    "@workspace/review-store": "workspace:*",
    "@workspace/runtime-env": "workspace:*",
    "@workspace/work-items-store": "workspace:*",
    "ai": "^7.0.26",
    "better-sqlite3": "12.10.0",
    "eve": "0.29.5",
    "jose": "^6.1.3",
    "just-bash": "^3.1.0",
    "microsandbox": "0.6.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.6"
  }
}
