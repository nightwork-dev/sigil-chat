# Ordinary local development needs no .env file. `pnpm dev` creates one
# worktree-local data root, agent binding secret, database, and owner automatically.
# See docs/guides/configuration.md for optional providers and integrations.

# Standard production configuration
# SIGIL_PUBLIC_URL=https://chat.example.com
# SIGIL_DATA_DIR=/var/lib/sigil-chat
# SIGIL_AGENT_BINDING_SECRET=
# BETTER_AUTH_SECRET=
# SIGIL_INSTALLATION_ID=sigil-chat-production
# SIGIL_INVITE_TOKEN_PEPPER_FILE=/run/secrets/invite_token_pepper

# Optional external database (otherwise SIGIL_DATA_DIR is used)
# SIGIL_DATABASE_URL=file:/var/lib/sigil-chat/sigil-chat.db

# Optional non-standard topology
# EVE_ORIGIN=
# SIGIL_EVE_AUTH_JWKS_URL=http://web:3000/api/auth/jwks

# Shared versioned roadmap; intentionally outside disposable SIGIL_DATA_DIR
# SIGIL_ROADMAP_DIR=

# Optional model-provider credentials. `agent.model` in
# fixtures/application/sigil-chat.yaml selects the provider; secrets stay here
# or in deployment secret mounts, never in fixtures.
# SIGIL_MODEL_OPENAI_COMPATIBLE_API_KEY=
# SIGIL_MODEL_OPENROUTER_API_KEY=
# SIGIL_MODEL_ANTHROPIC_API_KEY=
# SIGIL_HOSTED_MODEL_PROVIDER=openrouter
# SIGIL_HOSTED_MODEL_ID=anthropic/claude-sonnet-4.6

# Optional Gonk Fabric dispatcher. Leave GONK_FABRIC_RELAY_URL unset to keep
# the portable compute layer completely absent. `gonk-fabric-bootstrap`
# generates these values for loopback development.
# GONK_FABRIC_RELAY_URL=wss://fabric.example.com
# GONK_FABRIC_STATE_DIR=/var/lib/sigil-chat/fabric
# GONK_FABRIC_DISPATCHER_IDENTITY_FILE=/run/secrets/fabric_dispatcher_identity
# GONK_FABRIC_DISPATCHER_CERTIFICATE_FILE=/run/secrets/fabric_dispatcher_certificate
# GONK_FABRIC_WORKER_CERTIFICATE_FILE=/run/secrets/fabric_image_worker_certificate
# GONK_FABRIC_AUTHORITY_PRIVATE_KEY_FILE=/run/secrets/fabric_authority_private_key
# GONK_FABRIC_AUTHORITY_KEY_ID=
# GONK_FABRIC_RESTRICTION_POLICY_REFS=private-local
# GONK_FABRIC_IMAGE_PROVIDER=comfyui
# GONK_FABRIC_IMAGE_MODEL_ID=local/chroma
# GONK_FABRIC_ALLOW_INSECURE_LOOPBACK=0
