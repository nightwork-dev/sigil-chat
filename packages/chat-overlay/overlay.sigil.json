    "packages/graph/tsconfig.json",
    "packages/graph/vitest.config.ts",
    "packages/review/package.json",
    "packages/review/src/components/acceptance-checklist.tsx",
    "packages/review/src/components/annotation-composer.tsx",
    "packages/review/src/components/annotation-feed.tsx",
    "packages/review/src/components/decisions-panel.tsx",
    "packages/review/src/components/review-debt-panel.tsx",
    "packages/review/src/components/review-workbench.tsx",
    "packages/review/src/components/revision-history.tsx",
    "packages/review/src/lib/logic.test.ts",
    "packages/review/src/lib/logic.ts",
    "packages/review/src/lib/types.ts",
    "packages/review/tsconfig.json",
    "packages/ui/package.json",
    "packages/ui/src/components/agent-hud.tsx",
    "packages/ui/src/components/ambient-panel.tsx",
    "packages/ui/src/components/annotation-overlay.tsx",
    "packages/ui/src/components/blocks/kanban-board.tsx",
    "packages/ui/src/components/dnd/sortable.tsx",
    "packages/ui/src/components/floating-dock.tsx",
    "packages/ui/src/components/layouts/shells.tsx",
    "packages/ui/src/components/part-projection.tsx",
    "packages/ui/src/components/tool-call.tsx",
    "packages/ui/src/components/tool-renderer-registry.tsx",
    "packages/ui/src/components/views/entity-browser.tsx",
    "packages/ui/src/lib/agent-hud-state.test.ts",
    "packages/ui/src/lib/agent-hud-state.ts",
    "apps/web/CLAUDE.md",
    "apps/web/components.json",
    "apps/web/package.json",
    "apps/web/public/apple-touch-icon.png",
    "apps/web/public/favicon-16.png",
    "apps/web/public/favicon-32.png",
    "apps/web/public/favicon-48.png",
    "apps/web/public/favicon.ico",
    "apps/web/public/gallery/pack-1.png",
    "apps/web/public/gallery/pack-2.png",
    "apps/web/public/gallery/pack-3.png",
    "apps/web/public/gallery/pack-4.png",
    "apps/web/public/gallery/pack-5.png",
    "apps/web/public/gallery/pack-6.png",
    "apps/web/public/icon-192.png",
    "apps/web/public/icon-512.png",
    "apps/web/public/icon.png",
    "apps/web/public/manifest.json",
    "apps/web/public/robots.txt",
    "apps/web/scripts/finalize-spa.mjs",
    "apps/web/src/components/theme-picker.tsx",
    "apps/web/src/lib/api.ts",
    "apps/web/src/lib/site.ts",
    "apps/web/src/lib/theme-derive.test.ts",
    "apps/web/src/lib/theme-derive.ts",
    "apps/web/src/lib/theme-source-writer.test.ts",
    "apps/web/src/lib/theme-source-writer.ts",
    "apps/web/src/lib/theme.tsx",
    "apps/web/src/router.tsx",
    "apps/web/src/routes/-types.ts",
    "apps/web/src/routes/__root.tsx",
    "apps/web/src/routes/footer.tsx",
    "apps/web/src/routes/footer/index.tsx",
    "apps/web/src/routes/index.tsx",
    "apps/web/src/routes/inspector.tsx",
    "apps/web/src/routes/inspector/index.tsx",
    "apps/web/src/routes/menubar.tsx",
    "apps/web/src/routes/menubar/index.tsx",
    "apps/web/src/routes/menubar/workflow.tsx",
    "apps/web/src/routes/settings.tsx",
    "apps/web/src/routes/settings/appearance.tsx",
    "apps/web/src/routes/settings/general.tsx",
    "apps/web/src/routes/settings/index.tsx",
    "apps/web/src/routes/settings/notifications.tsx",
    "apps/web/src/routes/sidebar.tsx",
    "apps/web/src/routes/sidebar/canvas.tsx",
    "apps/web/src/routes/sidebar/index.tsx",
    "apps/web/src/routes/split.tsx",
    "apps/web/src/routes/split/$id.tsx",
    "apps/web/src/routes/split/index.tsx",
    "apps/web/src/styles/themes.css",
    "apps/web/tsconfig.json",
    "apps/web/vite.config.static.ts",
    "apps/web/vite.config.ts",
    "apps/web/vitest.config.ts"
  ],
  "rewrite": [
    {
      "file": "package.json",
      "jsonPath": "$.engines.node",
      "value": ">=24"
    },
    {
      "file": "package.json",
      "jsonPath": "$.scripts.auth:generate",
      "value": "pnpm --dir apps/web auth:generate"
    },
    {
      "file": "package.json",
      "jsonPath": "$.scripts.auth:migrate",
      "value": "pnpm --dir apps/web auth:migrate"
    },
    {
      "file": "package.json",
      "jsonPath": "$.scripts.seed:scope-composition",
      "value": "pnpm --dir apps/web seed:scope-composition"
    },
    {
      "file": "apps/agent/package.json",
      "jsonPath": "$.name",
      "value": "{{packageName}}-agent"
    },
    {
      "file": "apps/agent/package.json",
      "jsonPath": "$.scripts.dev",
      "value": "portless run --name {{devHost}}-agent eve dev --no-ui --host 127.0.0.1"
    },
    {
      "file": "apps/web/package.json",
      "jsonPath": "$.name",
      "value": "{{packageName}}"
    },
    {
      "file": "apps/web/package.json",
      "jsonPath": "$.scripts.dev",
      "value": "portless {{devHost}} vite dev --host"
    },
    {
      "file": "sigil.doctor.json",
      "jsonPath": "$.id",
      "value": "{{packageName}}"
    },
    {
      "file": "sigil.doctor.json",
      "jsonPath": "$.serviceProbes.0.url",
      "value": "http://{{devHost}}-agent.localhost:1355/eve/v1/health"
    },
    {
      "file": "sigil.doctor.json",
      "jsonPath": "$.serviceProbes.0.remediation",
      "value": "Start the Eve app with pnpm --filter {{packageName}}-agent dev."
    }
  ]
}
