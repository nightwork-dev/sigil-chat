{
  "sigilOverlayVersion": 1,
  "name": "sigil-chat",
  "displayName": "Sigil Chat",
  "filesRoot": "files",
  "compatibility": {
    "scaffoldProtocol": 1,
    "template": "sigil-design"
  },
  "replacements": [
    "package.json",
    "pnpm-workspace.yaml",
    "turbo.json",
    "packages/chat/package.json",
    "packages/chat/src/components/chat-actions.tsx",
